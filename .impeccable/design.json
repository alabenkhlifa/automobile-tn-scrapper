      "description": "Secondary actions, pager, retry.",
      "html": "<button class=\"ds-btn\">Suivant</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;border:1px solid var(--line,#e2e8f0);border-radius:7px;background:#fff;font:500 13px Inter,sans-serif;color:#334155;cursor:pointer;transition:background-color 120ms ease,border-color 120ms ease}.ds-btn:hover{background:#f8fafc;border-color:#cbd5e1}.ds-btn:focus-visible{outline:2px solid #4f46e5;outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "One per header: export. Ink, never indigo.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"><path d=\"M8 2.5v8m-3.5-3.5L8 10.5l3.5-3.5M3 13.5h10\"/></svg>Exporter CSV</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;border:1px solid #0f172a;border-radius:7px;background:#0f172a;color:#fff;font:500 13px Inter,sans-serif;cursor:pointer;transition:background-color 120ms ease}.ds-btn-primary:hover{background:#1e293b}.ds-btn-primary:focus-visible{outline:2px solid #4f46e5;outline-offset:2px}"
    },
