      "css": ".ds-bars{display:grid;gap:2px;width:360px;font:13px Inter,sans-serif;font-variant-numeric:tabular-nums}.ds-bar{display:grid;grid-template-columns:100px minmax(0,1fr) 56px 40px;align-items:center;gap:10px;height:28px;color:#334155}.ds-track{height:8px;border-radius:4px;background:#f1f5f9;overflow:hidden}.ds-track i{display:block;height:100%;border-radius:4px;background:#4f46e5}.ds-bar b{text-align:right;font-weight:500;color:#0f172a}.ds-bar em{font-style:normal;text-align:right;font-size:12px;color:#64748b}"
