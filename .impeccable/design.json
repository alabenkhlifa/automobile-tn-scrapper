      "html": "<label class=\"ds-field\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"#64748b\" stroke-width=\"1.6\"><circle cx=\"7\" cy=\"7\" r=\"4.5\"/><path d=\"m10.5 10.5 3 3\"/></svg><input class=\"ds-input\" placeholder=\"Rechercher\"></label>",
      "css": ".ds-field{position:relative;display:inline-flex;align-items:center}.ds-field svg{position:absolute;left:9px;pointer-events:none}.ds-input{height:32px;width:240px;border:1px solid #e2e8f0;border-radius:7px;background:#fff;padding:0 10px 0 30px;font:400 13px Inter,sans-serif;color:#0f172a;transition:border-color 120ms ease,box-shadow 120ms ease}.ds-input::placeholder{color:#94a3b8}.ds-input:hover{border-color:#cbd5e1}.ds-input:focus{outline:none;border-color:#4f46e5;box-shadow:0 0 0 3px rgba(79,70,229,.15)}"
    },
    {
