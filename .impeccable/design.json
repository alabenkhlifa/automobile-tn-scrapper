      "refersTo": "nav-item",
      "description": "Route list with counts; active in indigo wash.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#\">Neuf TN<span>548</span></a><a class=\"ds-nav-item\" aria-current=\"page\" href=\"#\">Occasion TN<span>12 493</span></a><a class=\"ds-nav-item\" href=\"#\">Europe<span>2 277</span></a></nav>",
      "css": ".ds-nav{display:grid;gap:2px;width:204px;padding:14px;background:#f8fafc;font:13px Inter,sans-serif;font-variant-numeric:tabular-nums}.ds-nav-item{display:flex;align-items:center;padding:7px 8px;border-radius:7px;font-weight:500;color:#334155;text-decoration:none;transition:background-color 120ms ease}.ds-nav-item span{margin-left:auto;font-size:12px;color:#64748b}.ds-nav-item:hover{background:#f1f5f9}.ds-nav-item[aria-current=page]{background:#eef2ff;color:#4f46e5}.ds-nav-item[aria-current=page] span{color:#4f46e5}.ds-nav-item:focus-visible{outline:2px solid #4f46e5;outline-offset:2px}"
