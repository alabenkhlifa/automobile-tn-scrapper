      "description": "Label, metric with unit, direction sub line, indigo sparkline.",
      "html": "<div class=\"ds-kpi\"><span class=\"ds-kpi-label\">Prix médian demandé</span><div><div class=\"ds-kpi-value\">44 000<small>DT</small></div><div class=\"ds-kpi-sub\">−8,3 % depuis le 14 avr.</div></div><svg width=\"84\" height=\"32\"><path d=\"M2 6 L20 10 L34 18 L50 20 L66 24 L82 25\" fill=\"none\" stroke=\"#4f46e5\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>",
      "css": ".ds-kpi{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:0 12px;width:260px;padding:14px 16px;border:1px solid #e2e8f0;border-radius:10px;background:#fff;font:13px/1.45 Inter,sans-serif;font-variant-numeric:tabular-nums;color:#0f172a}.ds-kpi-label{grid-column:1/-1;color:#64748b;font-weight:500}.ds-kpi svg{align-self:end}.ds-kpi-value{font-size:24px;font-weight:600;letter-spacing:-.02em;margin-top:6px}.ds-kpi-value small{font-size:13px;font-weight:500;color:#64748b;margin-left:3px;letter-spacing:0}.ds-kpi-sub{font-size:12px;font-weight:500;color:#047857;margin-top:3px}"
    },
